                  "snippet": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "url"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
