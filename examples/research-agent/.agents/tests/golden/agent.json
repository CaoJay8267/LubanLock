    "name": "research-agent",
    "settings": {
      "audience": "developers"
    },
    "skills": {
      "citation-format": {
        "description": "Render findings with stable, verifiable citations.",
        "file": "skills/citation-format/SKILL.md",
        "instructions": "# Citation format\n\nUse numbered citations in square brackets and a source list at the end:\n\n```text\nFinding text [1].\n\n[1] Title — https://example.com/page (accessed 2026-01-01)\n```\n\nRules:\n\n- Cite the page that contains the claim, not a search-result page.\n- Keep the access date in ISO 8601 form.\n- If two sources disagree, present both and label the conflict.",
        "metadata": {
          "version": "0.1.0"
        },
        "name": "citation-format"
      },
      "web-research": {
        "allowed_tools": [
          "web_search",
          "web_fetch"
        ],
        "description": "Plan and execute a web investigation with primary sources.",
        "file": "skills/web-research/SKILL.md",
        "files": [
          "skills/web-research/checklist.md"
        ],
        "instructions": "# Web research\n\n1. Turn the question into two to five search queries with different wording.\n2. Run `web_search`, then open the most promising results with `web_fetch`.\n3. For every claim, record the URL and the exact sentence that supports it.\n4. Cross-check each important claim in a second independent source.\n5. Stop when new searches only repeat sources you already have.\n\nUse [checklist.md](checklist.md) when you need the detailed review checklist.",
        "metadata": {
          "version": "0.1.0"
        },
        "name": "web-research"
      }
    },
    "subagents": {
      "source-checker": {
        "description": "Verifies claims against their cited sources and reports conflicts.",
        "file": "agents/source-checker.md",
        "instructions": "You are a verification specialist. For every claim you receive:\n\n1. Open the cited URL and quote the sentence that supports or contradicts it.\n2. Mark the claim `supported`, `unclear` or `contradicted`.\n3. If a source is unavailable, say so instead of guessing.\n\nReturn a compact table: claim id, verdict, evidence quote, source URL.",
        "model": "default",
        "name": "source-checker",
        "skills": [
          "citation-format"
        ],
        "tools": [
          "web_fetch"
        ],
        "version": "0.1.0"
      }
    },
    "tags": [
      "research",
      "example"
    ],
    "tasks": {
      "plan-research": {
        "description": "Decompose a research question into searchable sub-questions.",
        "examples": [
          {
            "input": {
              "question": "Does the project support Windows?"
            },
            "output": {
              "subquestions": [
                "Which Windows versions are documented?",
                "Are there platform-specific limitations?"
              ]
            }
          }
        ],
        "file": "tasks/plan-research.yaml",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "question": {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "question"
          ],
          "type": "object"
        },
        "name": "plan-research",
        "output_schema": {
          "properties": {
            "subquestions": {
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "subquestions"
          ],
          "type": "object"
        },
        "prompt": {
          "file": "prompts/plan-research.md",
          "text": "# Planning prompt\n\nYou are planning a web investigation.\n\n1. Rewrite the question in your own words.\n2. List two to five sub-questions that together answer it.\n3. For each sub-question, name the kind of source that would count as\n   authoritative.\n4. Return the sub-questions as a JSON array. Do not answer the question yet."
        },
        "skills": [
          "web-research"
        ],
        "tags": [
          "planning"
        ],
        "version": "0.1.0"
      },
      "summarize": {
        "description": "Turn verified findings into a short cited answer.",
        "examples": [
          {
            "description": "Two findings with one open question.",
            "input": {
              "findings": [
                "The spec is marked stable since 2025 [1].",
                "A deprecation is proposed for 2027 [2]."
              ],
              "question": "Is the format stable?"
            },
            "output": {
              "answer": "Findings: ... Evidence: ... Open questions: ..."
            }
          }
        ],
        "file": "tasks/summarize.yaml",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "findings": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "question": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "question",
            "findings"
          ],
          "type": "object"
        },
        "name": "summarize",
        "output_schema": {
          "properties": {
            "answer": {
              "type": "string"
            }
          },
          "required": [
            "answer"
          ],
          "type": "object"
        },
        "prompt": {
          "text": "Write the final answer in three sections: Findings, Evidence, Open\nquestions. Use numbered citations from the citation format. Never add a\nclaim that is not backed by one of the provided findings."
        },
        "skills": [
          "citation-format"
        ],
        "tags": [
          "writing"
        ],
        "tools": [
          "save_note"
        ],
        "version": "0.1.0",
        "workflow": "quick-research"
      }
    },
