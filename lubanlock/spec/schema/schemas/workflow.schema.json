{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubanlock.dev/schemas/v1alpha1/workflow.schema.json",
  "title": "LubanLock workflow (.agent/workflows/<name>.yaml)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "lubanlock/v1alpha1" },
    "extends": { "$ref": "common.schema.json#/$defs/name" },
    "kind": { "const": "Workflow" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "portName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "maxLength": 64
    },
    "spec": {
      "type": "object",
      "required": ["entry", "nodes"],
      "additionalProperties": false,
      "properties": {
        "entry": { "$ref": "common.schema.json#/$defs/name" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "maxItems": 500,
          "items": { "$ref": "#/$defs/edge" }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/name" },
        "kind": {
          "type": "string",
          "enum": ["agent", "task", "subagent", "tool", "human", "join", "workflow"]
        },
        "ref": {
          "type": "string",
          "description": "Name of the referenced entity. Required for every kind except 'agent', 'human' and 'join'.",
          "minLength": 1,
          "maxLength": 64
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portName" },
          "uniqueItems": true,
          "maxItems": 32
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/portName" },
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/name" },
        "to": { "$ref": "common.schema.json#/$defs/name" },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
