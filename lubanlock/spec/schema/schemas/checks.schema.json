{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubanlock.dev/schemas/v1alpha1/checks.schema.json",
  "title": "LubanLock declarative checks (.agent/tests/checks.yaml)",
  "type": "object",
  "required": ["apiVersion", "kind", "checks"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "lubanlock/v1alpha1" },
    "kind": { "const": "Checks" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["path", "op"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "path": {
          "type": "string",
          "description": "Dot-separated path into the compiled agent (e.g. tools.read_file.input_schema). Empty means the whole agent.",
          "maxLength": 512
        },
        "op": {
          "type": "string",
          "enum": [
            "exists",
            "not_exists",
            "equals",
            "contains",
            "matches",
            "min_items",
            "max_items",
            "min_length",
            "max_length"
          ]
        },
        "value": {}
      }
    }
  }
}
