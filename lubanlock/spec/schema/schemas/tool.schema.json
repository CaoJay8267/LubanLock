{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubanlock.dev/schemas/v1alpha1/tool.schema.json",
  "title": "LubanLock tool declaration (.agent/tools/<name>.yaml)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "lubanlock/v1alpha1" },
    "extends": { "$ref": "common.schema.json#/$defs/name" },
    "kind": { "const": "Tool" },
    "metadata": {
      "description": "Tool identity. A description is mandatory: tools are unusable without one.",
      "$ref": "common.schema.json#/$defs/metadata",
      "required": ["name", "description"]
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "required": ["input_schema"],
      "additionalProperties": false,
      "properties": {
        "input_schema": {
          "type": "object",
          "description": "JSON Schema for the tool input. Must describe an object."
        },
        "output_schema": {
          "type": "object",
          "description": "Optional JSON Schema for the tool result."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read_only": { "type": "boolean" },
            "idempotent": { "type": "boolean" },
            "destructive": { "type": "boolean" },
            "open_world": { "type": "boolean" }
          }
        },
        "source": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["builtin", "mcp", "http", "external"]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    }
  }
}
