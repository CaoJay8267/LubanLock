{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotagent.dev/schemas/v1alpha1/skill.schema.json",
  "title": "Agent Skills SKILL.md front matter",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent Skills name: 1-64 lowercase alphanumerics and single hyphens, matching the parent directory name.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "description": "What the skill does and when to use it.",
      "minLength": 1,
      "maxLength": 1024
    },
    "license": {
      "type": "string",
      "description": "License name or a reference to a bundled license file.",
      "minLength": 1,
      "maxLength": 200
    },
    "compatibility": {
      "type": "string",
      "description": "Environment requirements (product, packages, network access, ...).",
      "minLength": 1,
      "maxLength": 500
    },
    "metadata": {
      "type": "object",
      "description": "Arbitrary string key/value metadata.",
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 50
    },
    "allowed-tools": {
      "type": "string",
      "description": "Space-separated tool names the skill is pre-approved to use (experimental in the standard).",
      "maxLength": 2000
    }
  }
}
