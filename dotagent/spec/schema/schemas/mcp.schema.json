{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotagent.dev/schemas/v1alpha1/mcp.schema.json",
  "title": "DotAgent MCP server declaration (.agents/mcp.json)",
  "type": "object",
  "required": ["mcpServers"],
  "additionalProperties": false,
  "properties": {
    "mcpServers": {
      "type": "object",
      "description": "Map of server name to MCP server configuration (the shared mcpServers shape).",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/server"
      }
    }
  },
  "$defs": {
    "server": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["stdio", "http", "sse", "ws", "sdk"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
