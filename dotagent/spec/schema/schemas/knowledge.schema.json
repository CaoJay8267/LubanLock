{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotagent.dev/schemas/v1alpha1/knowledge.schema.json",
  "title": "DotAgent knowledge front matter (.agent/knowledge/**/*.md)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "$ref": "common.schema.json#/$defs/name" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tags": { "$ref": "common.schema.json#/$defs/tags" },
    "labels": { "$ref": "common.schema.json#/$defs/labels" },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high"]
    }
  }
}
